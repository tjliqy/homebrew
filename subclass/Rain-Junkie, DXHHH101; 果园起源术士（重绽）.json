	"subclassFeature": [
		{
			"ENG_name": "Orchard Origin",
			"name": "果园起源",
			"source": "OrchardSorcReflourished",
			"className": "术士",
			"classSource": "PHB",
			"subclassShortName": "果园",
			"subclassSource": "OrchardSorcReflourished",
			"level": 1,
			"entries": [
				"你的魔法与自然的美丽和优雅相连。也许你的魔法得自一位神秘的树精，或是偶然发现了一个古老的森林仪式。无论你如何获得它，你都能将这份美丽映照于你为保护盟友而创造的花朵之中。",
				{
					"type": "refSubclassFeature",
					"subclassFeature": "果园魔法|术士||果园|OrchardSorcReflourished|1"
				},
				{
					"type": "refSubclassFeature",
					"subclassFeature": "鼓舞绽放|术士||果园|OrchardSorcReflourished|1"
				},
				{
					"type": "refSubclassFeature",
					"subclassFeature": "花园絮语|术士||果园|OrchardSorcReflourished|1"
				}
			]
		},
		{
			"ENG_name": "Garden Chatter",
			"name": "花园絮语",
			"source": "OrchardSorcReflourished",
			"className": "术士",
			"classSource": "PHB",
			"subclassShortName": "果园",
			"subclassSource": "OrchardSorcReflourished",
			"level": 1,
			"header": 1,
			"entries": [
				"同样在第1级，你可以与非魔法花朵交流。你可以询问花朵其紧邻区域过去一天内发生的事件，获取有关经过该处的生物、天气以及其他与附近区域相关的情况的信息。每当你与植物互动而进行魅力检定时，若你的熟练加值适用于该检定，则将其加倍。"
			]
		},
		{
			"ENG_name": "Inspiring Bloom",
			"name": "鼓舞绽放",
			"source": "OrchardSorcReflourished",
			"className": "术士",
			"classSource": "PHB",
			"subclassShortName": "果园",
			"subclassSource": "OrchardSorcReflourished",
			"level": 1,
			"header": 1,
			"entries": [
				"从你在第1级选择此起源开始，你的法术便唤起花朵蓬勃的自然能量。每当你施展1环或更高环阶的法术时，你可以召出一簇魔法花朵，使其绽放在你自己的护甲或衣物上，或绽放在你30尺内你能看见的一名自愿生物的护甲或衣物上。由你选择绽放哪种花朵，所选种类的花朵将其列明的增益给予该生物：",
				{
					"ENG_name": "Chamomile",
					"type": "entries",
					"name": "洋甘菊",
					"entries": [
						"这些白色小花象征速度。该生物可以在其敏捷检定上附加{@dice 1d4}，且其速度增加5尺。"
					]
				},
				{
					"ENG_name": "Dandelion",
					"type": "entries",
					"name": "蒲公英",
					"entries": [
						"这些黄色小花代表希望。该生物的死亡豁免检定具有优势，且其昏迷时受到的任何重击都变为普通命中。"
					]
				},
				{
					"ENG_name": "Lavender",
					"type": "entries",
					"name": "薰衣草",
					"entries": [
						"这些薰衣草色的花朵象征力量。该生物可以在其力量检定上附加{@dice 1d4}，且该生物的武器攻击在克服抗性时视为魔法攻击。"
					]
				},
				{
					"ENG_name": "Lily",
					"type": "entries",
					"name": "百合",
					"entries": [
						"这些常为白色或粉色的花朵象征荣誉。该生物在其每个回合开始时，获得数量等于1 + 你的术士等级除以5（向上取整）的临时生命值。"
					]
				},
				{
					"ENG_name": "Sunflower",
					"type": "entries",
					"name": "向日葵",
					"entries": [
						"这些鲜黄色的花朵映照太阳，激发活力。该生物在对抗中毒和疾病的豁免检定上具有优势。"
					]
				},
				"花朵持续1分钟，且一个生物同一时间只能从生长于其上的一种花朵中获益；若有新品种的花朵生长到一个生物身上，先前的花朵便会枯萎凋零。"
			]
		},
		{
			"ENG_name": "Orchard Magic",
			"name": "果园魔法",
			"source": "OrchardSorcReflourished",
			"className": "术士",
			"classSource": "PHB",
			"subclassShortName": "果园",
			"subclassSource": "OrchardSorcReflourished",
			"level": 1,
			"header": 1,
			"entries": [
				"当你在此职业中达到特定等级时，你会习得额外的法术，如果园法术表所示。这些法术对你是术士法术，但不计入你已知的术士法术数量。",
				"每当你提升一个术士等级时，你可以选择一个环阶相同的新法术，来替换你因此特性习得的一个法术。该法术必须是一个{@filter 来自术士、魔契师或法师法术列表中的咒法或变化法术|spells|class=术士;魔契师;法师|school=C;T|level=1;2;3;4;5}。",
				{
					"type": "table",
					"caption": "果园法术",
					"colLabels": [
						"术士等级",
						"法术"
					],
					"colStyles": [
						"col-2 text-center",
						"col-10"
					],
					"rows": [
						[
							"1环",
							"{@spell 德鲁伊伎俩}, {@spell 纠缠术}, {@spell 神莓术}"
						],
						[
							"3环",
							"{@spell 树肤术}, {@spell 荆棘丛生}"
						],
						[
							"5环",
							"{@spell 昼明术}, {@spell 植物滋长}"
						],
						[
							"7环",
							"{@spell 擒抱藤}, {@spell 自然守卫|XGE}（战争巨树改为影响魅力而非感知）"
						],
						[
							"9环",
							"{@spell 树跃术}, {@spell 自然之怒|XGE}"
						]
					]
				}
			]
		},
		{
			"ENG_name": "Exhilarating Bloom",
			"name": "欢欣绽放",
			"source": "OrchardSorcReflourished",
			"className": "术士",
			"classSource": "PHB",
			"subclassShortName": "果园",
			"subclassSource": "OrchardSorcReflourished",
			"level": 6,
			"header": 2,
			"entries": [
				"从第6级起，你可以轻易地传播你的花朵带来的喜悦。当你在一个生物身上种下花朵时，你可以选择消耗1点术法点，在原生物30尺内你能看见的另一名自愿生物身上种下同一种花朵。如果你是花朵的第一目标，你可以选择在另一个生物身上种下另一种花朵，而非同一种。"
			]
		},
		{
			"ENG_name": "Swirl of Petals",
			"name": "花瓣回旋",
			"source": "OrchardSorcReflourished",
			"className": "术士",
			"classSource": "PHB",
			"subclassShortName": "果园",
			"subclassSource": "OrchardSorcReflourished",
			"level": 6,
			"header": 2,
			"entries": [
				"同样在第6级，你可以扭转你的自然魔法，以更好地保护你的盟友。以你回合内的一个附赠动作，你可以令花瓣在一个你60尺内能看见的生物周身盘旋而起。直到你的下个回合开始前，对该生物的攻击检定具有劣势。",
				"一旦使用了此特性，你必须完成一次短休或长休后才能再次使用。"
			]
		},
		{
			"ENG_name": "Reverberating Bloom",
			"name": "回响绽放",
			"source": "OrchardSorcReflourished",
			"className": "术士",
			"classSource": "PHB",
			"subclassShortName": "果园",
			"subclassSource": "OrchardSorcReflourished",
			"level": 14,
			"header": 2,
			"entries": [
				"从第14级起，你可以为你的花朵注入特异的能量，即刻强化被你种花之人的能力。当你在一个生物身上种下你的花朵时，你可以消耗1点术法点，给予一个被你种下花朵的生物一项额外的立即增益，从以下选项中选择其一项：",
				{
					"ENG_name": "Aromatic",
					"type": "entries",
					"name": "芳香",
					"entries": [
						"如果该生物正处于一个允许它每回合重复进行豁免检定的法术或效应的影响之下，它可以尝试挣脱该效应。"
					]
				},
				{
					"ENG_name": "Idyllic",
					"type": "entries",
					"name": "闲适",
					"entries": [
						"该生物可以用其反应移动至多等于其速度的距离。如果此移动引发任何借机攻击，这些攻击具有劣势。"
					]
				},
				{
					"ENG_name": "Supple",
					"type": "entries",
					"name": "柔韧",
					"entries": [
						"该生物可以用其反应进行一次武器攻击。"
					]
				}
			]
		},
		{
			"ENG_name": "Keeper of the Garden",
			"name": "花园守望者",
			"source": "OrchardSorcReflourished",
			"className": "术士",
			"classSource": "PHB",
			"subclassShortName": "果园",
			"subclassSource": "OrchardSorcReflourished",
			"level": 18,
			"header": 2,
			"entries": [
				"在第18级，你可以呼唤花园守望者来保护你和你的盟友。以一个动作，你可以消耗3点术法点召唤守望者\u2014\u2014一名{@creature 菘蓝树人|VGM}，它在持续时间内对你和你的同伴友善。为守望者掷先攻，它拥有自己的回合。它服从你向它发出的任何口头命令（无需你的动作），只要这些命令不违反其所属阵营。如果你没有向守望者发出任何命令，它会自卫抵御敌对生物，但不会采取任何其他动作。",
				"守望者显现1分钟，或直到它的生命值被降至0。",
				"一旦使用了此特性，你必须完成一次长休后才能再次使用。"
			]
		}
	]
