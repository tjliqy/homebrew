	"bookData": [
		{
			"id": "MLPCM&D",
			"source": "MLPCM&D",
			"data": [
				{
					"ENG_name": "Cutie Marks & Dragons DM Screen",
					"type": "section",
					"name": "可爱标志与龙·城主帷幕",
					"page": "Front",
					"entries": [
						{
							"type": "image",
							"href": {
								"type": "external",
								"url": "https://raw.githubusercontent.com/TheGiddyLimit/homebrew-img/main/img/MLPCM&D/DMScreen.webp"
							},
							"title": "可爱标志与龙·城主帷幕",
							"credit": "Leesha Hannigan"
						},
						{
							"type": "quote",
							"style": "quote-pull",
							"entries": [
								"一股名为\"谐律精华\"的强大魔法，召唤来了五位原本毫不相干的朋友。",
								"他们必须齐心协力，运用各自独特的力量，去发现小马国™一处失落境域中隐藏的古老魔法。"
							],
							"skipMarks": true
						},
						{
							"ENG_name": "Mystaria™",
							"type": "inset",
							"name": "米斯塔莉娅™",
							"entries": [
								"她在整个国度中探寻魔法与奥秘。每一次冒险，她都视为进一步领略宇宙奇观的良机。米斯塔莉娅™走到哪儿都带着她的书，可要是她把书塞错了鞍袋，就可能惹出乱子。",
								"职业：{@class 法师}"
							]
						},
						{
							"ENG_name": "Shadow Star™",
							"type": "inset",
							"name": "暗影之星™",
							"entries": [
								"无论她和朋友们面临怎样的挑战，她都能想出别出心裁的解决办法。她运用{@skill 隐匿}与头脑，热情地扫清前路上的障碍......也顺带捉弄朋友们一番。你永远猜不到暗影之星™的斗篷里又藏了什么新花招。",
								"职业：{@class 游荡者}"
							]
						},
						{
							"ENG_name": "Valor Stronghoof™",
							"type": "inset",
							"name": "勇毅壮蹄™",
							"entries": [
								"只要有人威胁她的朋友，她便会奋然冲入战斗。她以凶猛的力量和久经沙场的{@item 盾牌|phb}勇敢地守护队伍。漫长的一天结束时，勇毅壮蹄™最大的心愿，莫过于看到朋友们平安无事，围着篝火共享欢笑。",
								"职业：{@class 野蛮人}"
							]
						},
						{
							"ENG_name": "Spinner Talltail™",
							"type": "inset",
							"name": "织歌长尾™",
							"entries": [
								"她对荣耀毫不在意；",
								"只顾欢欣地追寻下一个故事！",
								"稍坐片刻，她便为你织就一支歌谣；",
								"她的{@item 鲁特琴|phb}技艺娴熟，让朋友们融洽相交。",
								"织歌长尾™深知故事更加美妙；",
								"当朋友们围坐一堂，共同分享之时。",
								"职业：{@class 吟游诗人}"
							]
						},
						{
							"ENG_name": "Woodheart the Kind™",
							"type": "inset",
							"name": "善良的木心™",
							"entries": [
								"无论小径通向何方，她总能在自然中发现美。森林馈赠的众多伙伴，她个个都爱，尤其偏爱她的魔宠小骑士。善良又体贴的木心知道，每天来上一颗{@spell 神莓术}的莓果，这只{@creature 独角兔|ToA}就会一直是忠实的朋友！",
								"职业：{@class 德鲁伊}"
							]
						},
						{
							"type": "image",
							"href": {
								"type": "external",
								"url": "https://raw.githubusercontent.com/TheGiddyLimit/homebrew-img/main/img/MLPCM&D/Ponies.webp"
							},
							"title": "可爱标志与龙·人偶与骰子"
						}
					]
				}
			]
		}
	]
