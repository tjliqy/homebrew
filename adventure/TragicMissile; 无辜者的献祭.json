	"adventureData": [
		{
			"id": "SacrificeOfInnocence",
			"source": "SoI",
			"data": [
				{
					"ENG_name": "Cover",
					"type": "section",
					"name": "封面",
					"id": "Cover",
					"entries": [
						"《凡戴尔的失落矿坑》的前奏",
						{
							"type": "image",
							"href": {
								"type": "external",
								"url": "https://raw.githubusercontent.com/TheGiddyLimit/homebrew/master/_img/SoI/SoI-01-cover.png"
							},
							"title": ""
						},
						"一场供最多四名1级角色进行的冒险"
					]
				},
				{
					"ENG_name": "Introduction",
					"type": "section",
					"name": "简介",
					"id": "Introduction",
					"entries": [
						"本迷你冒险受马特·科尔维尔（Matt Colville）的{@i 运作游戏}（Running the Game）视频系列启发而设计，旨在帮助一小队新玩家提升角色等级，免得他们在{@i 凡戴尔的失落矿坑}开局便惨遭屠戮。在尝试{@i 地精箭矢}之前，他们应获得足以升到2级的经验。"
					]
				},
				{
					"ENG_name": "Overview",
					"type": "section",
					"name": "概述",
					"id": "Overview",
					"entries": [
						"无冬城以南20英里处，高路旁的一座小村庄正饱受地精袭掠之苦。在最近一次袭击中，一名铁匠的女儿被掳走。",
						"袭击者把孩子带到了以东15英里、恰在无冬森林边缘之内的一座古老地下墓穴中。她目前还活着，未受伤害，被锁在一个小铁笼里。一名地精萨满正准备在仪式上献祭她，以驱除地下墓穴中的不死生物。"
					]
				},
				{
					"ENG_name": "Adventure Hook",
					"type": "section",
					"name": "冒险引子",
					"id": "Adventure Hook",
					"entries": [
						{
							"entries": [
								"本冒险以{@i 凡戴尔的失落矿坑}中{@i 在凡达林见我}引子的一个改编版本开始："
							],
							"type": "entries"
						},
						{
							"type": "insetReadaloud",
							"entries": [
								"在无冬城中，一名叫刚铎·寻岩者的矮人请你们把一货车补给送往东南方数日路程之外的粗陋边镇凡达林。刚铎显然兴致勃勃，而对此行的缘由却讳莫如深，只说他和他的兄弟们发现了\"大东西\"，还说只要你们把他的补给安全护送到凡达林的巴森补给店\u2014\u2014当地的一处贸易站\u2014\u2014他就付给你们每人十五枚金币。随后他骑着马，与一名叫西达尔·霍尔温特的战士护卫一道，先行出发，声称他需要早些到达去\"处理生意\"。",
								"你们正沿高路而行，刚离开无冬城一天，这时你们注意到，拉着这车补给的两头公牛中有一头开始跛行了。",
								"此刻正是{@i 塔森}（傍晚时分），一座小村庄就在前方。"
							]
						},
						{
							"entries": [
								"公牛的蹄子因蹄铁松脱而渗血。队伍可以治愈这只受伤的蹄子，但显然蹄铁需要由铁匠来更换。"
							],
							"type": "entries"
						},
						{
							"type": "image",
							"href": {
								"type": "external",
								"url": "https://raw.githubusercontent.com/TheGiddyLimit/homebrew/master/_img/SoI/SoI-02-bloodyHoof.png"
							},
							"title": ""
						},
						{
							"entries": [
								"当队伍抵达小村庄时，朗读以下内容："
							],
							"type": "entries"
						},
						{
							"type": "insetReadaloud",
							"entries": [
								"在你的右侧，一座圆筒形的石砌瞭望塔在12尺高的原木栅栏后巍然耸立。左边，一缕缕灰白的轻烟从仍在闷燃的旅店残骸中升起。再远处是一间杂货店，更远处是一间铁匠铺。一条车辙纵横的小径通向一座离道路颇有一段距离的大谷仓。"
							]
						}
					]
				},
				{
					"ENG_name": "The Hamlet of Evermist",
					"type": "section",
					"name": "永雾村",
					"id": "The Hamlet of Evermist",
					"entries": [
						"永雾村是高路旅人的一处粮食集散地和歇脚处。东部农田的作物在此加工后运往无冬城。村庄坐落在道路东侧，由一家{@b 旅店}、一家{@b 杂货店}、一间{@b 铁匠铺}和一座{@b 谷仓}组成。道路西侧，一圈栅栏环绕着一座古老的石砌{@b 瞭望塔}，村庄的防卫便仰赖于它。所有居民都是人类。",
						{
							"ENG_name": "Dewdrop Inn",
							"type": "entries",
							"name": "露滴旅店",
							"id": "Dewdrop Inn",
							"entries": [
								"旅店已被烧成平地，仍在冒烟，彻底损毁了。"
							]
						},
						{
							"ENG_name": "Evermist Sundry",
							"type": "entries",
							"name": "永雾杂货店",
							"id": "Evermist Sundry",
							"entries": [
								"杂货店正在等待补货。对于\"冒险装备\"表上的任意一件特定物品，掷一颗1d4来决定是否有货。掷出1表示该物品缺货。",
								"柜台后的商人泰奥斯·维特拉姆是一位瘦削的灰发老人，蓄着络腮胡。他可以向队伍提供以下信息：",
								{
									"type": "list",
									"items": [
										"自新月以来，永雾村已在黑暗中遭到三次袭击。前两次袭击都被瞭望塔驻军击退。",
										"最近一次袭击发生在今天{@i 葛德斯维克}（黎明前），旅店被洗劫一空，铁匠的女儿被掳走。一名驻军士兵在战斗中阵亡。",
										"在抢救出能带走的东西后，旅店老板和他的家人已于今天{@i 埃尔桑}（上午晚些时候）启程前往无冬城。"
									]
								}
							]
						},
						{
							"ENG_name": "Noble Forge",
							"type": "entries",
							"name": "高贵锻造铺",
							"id": "Noble Forge",
							"entries": [
								"这间铁匠铺比一般的大，还带有一座马厩。后面是起居的住处。",
								"铁匠费鲁斯·斯特莱克是个约莫40岁的壮硕男子，蓄着浓密的深色胡须。他会开价5枚铜币为公牛重钉蹄铁，除此之外少言寡语。若有人提起他的女儿，他便会开始落泪。",
								"在队伍离开铁匠铺之前，朗读以下文本：",
								{
									"type": "insetReadaloud",
									"entries": [
										"一名年轻女子冲了进来，奔向铁匠。",
										"她显然心急如焚，压低声音向他恳求，并朝你们的方向比划。铁匠摇了摇头，咆哮道：\"咱们没啥钱财可给，而且她这会儿肯定死定咧！\"女子无可奈何，转向你们，双手合十恳求道：\"求求你们找回我们的小女儿！\""
									]
								},
								"在为方才的冒失致歉、并自我介绍是费鲁斯的妻子之后，玛戈会脱口说出以下内容：",
								{
									"type": "list",
									"items": [
										"他们的女儿十二小时前被地精掳走；她今年七岁，名叫蕾米。",
										"瞭望塔驻军的指挥官正悬赏地精。"
									]
								},
								"玛戈会竭尽全力说服队伍去找回蕾米，无论死活。",
								"如果队伍接受任务，费鲁斯会提出照看那两头公牛，把它们和货车一起安置在他的马厩里，直到队伍归来。"
							]
						},
						{
							"ENG_name": "Watchtower",
							"type": "entries",
							"name": "瞭望塔",
							"id": "Watchtower",
							"entries": [
								{
									"type": "image",
									"href": {
										"type": "external",
										"url": "https://raw.githubusercontent.com/TheGiddyLimit/homebrew/master/_img/SoI/SoI-03-killAllGobbos.png"
									},
									"title": ""
								},
								{
									"type": "entries",
									"entries": [
										"奉领主联盟之命，六名{@creature 警卫|MM|警卫}（其中一名新近阵亡）与{@creature 斥候索恩|SoI|索恩}（一名{@b 斥候}）驻扎于此。"
									]
								},
								{
									"type": "insetReadaloud",
									"entries": [
										"这座古老的石砌瞭望塔建于高地之上，有六层之高，视野开阔，可俯瞰四野。"
									]
								},
								{
									"type": "entries",
									"entries": [
										"木栅栏的大门敞开着。",
										"两名警卫正在瞭望：一人在沿着栅栏内侧的平台巡逻，另一人在塔顶扫视地平线。队伍接近大门时会被喝问。如果他们说明来意且看起来没有威胁，就会受邀入内。"
									]
								},
								{
									"type": "insetReadaloud",
									"entries": [
										"除高塔之外，栅栏内还设有一座营房、一座马厩，以及一个圈着五匹马和一头骡子的围场。"
									]
								},
								{
									"type": "entries",
									"entries": [
										"院子中央，三名警卫神情肃穆地正在搭建看似葬礼火堆的东西。几只鸡在四处游荡。",
										"队伍可以在院子里自由活动，但不会被允许进入营房或塔内。",
										"索恩和警卫们并不了解这座塔的历史。一个审视高塔并在{@dc 14} 智力（{@skill 历史}）检定中成功的角色可以辨明以下内容："
									]
								},
								{
									"ENG_name": "Elven Portal Tower",
									"type": "inset",
									"name": "精灵传送门塔",
									"entries": [
										"数千年前，这类高塔由伊尔法恩的精灵建造，在艾林塔尔达（今深水城）与伊卢斯克（今卢斯坎）之间按固定间隔矗立。塔内的传送门使精灵军队得以沿剑湾北部快速部署。",
										"虽然这些塔建造得足以抵御岁月的侵蚀，但大多数仍毁于战争或背叛。这一座看似伤痕累累，却完好无损。"
									]
								},
								{
									"type": "entries",
									"entries": [
										"尽管塔内（三层）仍有数道拱门伫立，其中却没有激活的传送门。",
										"一名警卫会走到塔基的一扇门前通报索恩，他正在里面起草呈交领主联盟的报告。索恩虽然疲惫但态度和蔼，会走出来询问自己能为队伍做些什么。若被问及悬赏，他会说地精耳朵每只值5枚银币。若被问及袭击或那堆火堆的事，他会分享以下信息："
									]
								},
								{
									"type": "list",
									"items": [
										"得知绑架之事后，他带着部下追击袭击者，在以东五英里的一座池塘附近追上了他们。他们遭到十二只地精的伏击，领头的是一名骑着座狼的大地精。他们设法杀死了那头座狼和三只地精，但也折损了一名自己人。他们随即脱离战斗，于黎明前返回永雾村。",
										"铁匠的女儿很受驻军喜爱。追击她违反了他们坚守哨所的既定命令。",
										"他怀疑旅店被纵火是为了声东击西。"
									]
								},
								{
									"type": "entries",
									"entries": [
										"塔二楼索恩的住处里有一只上锁的保险箱。它以红底上的金色王冠图案为记，内装400枚银币。",
										"如果队伍表示打算寻找蕾米，索恩会建议他们轻装上路，把不需要的东西留下。尽管他不太可能再让手下的警卫离开永雾村出击，但若有角色提出请求并通过{@dc 10} 魅力（{@skill 说服}）检定，索恩本人会为队伍追踪地精。"
									]
								},
								{
									"ENG_name": "Thorne",
									"type": "entries",
									"name": "索恩",
									"entries": [
										{
											"type": "image",
											"href": {
												"type": "external",
												"url": "https://raw.githubusercontent.com/TheGiddyLimit/homebrew/master/_img/SoI/SoI-04-thorne.png"
											},
											"title": ""
										},
										{
											"type": "entries",
											"entries": [
												"这位驻军指挥官想要铲除地精袭击者，并将队伍视为达成这一目标的手段。",
												"如果他不明着加入队伍，也会暗中跟随并监视他们的进展。角色们要等到他在地下墓穴外加入队伍对地精的攻击时，才会察觉他的存在。",
												"这名NPC能帮助故事保持在正轨上，并保护玩家免遭\"全灭\"（TPK）。"
											]
										}
									]
								}
							]
						},
						{
							"ENG_name": "Granary",
							"type": "entries",
							"name": "谷仓",
							"id": "Granary",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"这座巨大的无窗建筑从外面上着锁，无人居住。内部地面为石质，用于晾晒脱粒后的谷物。装着亚麻、燕麦、黑麦、玉米、大麦和小麦的麻袋堆靠在内墙上。干草捆存放在草料阁楼里。一间小小的档案室里堆满了文书和账册。",
										"任何在这座建筑周围窥探或闯入的人，都会招来瞭望塔驻军的负面关注。"
									]
								}
							]
						}
					]
				},
				{
					"ENG_name": "Goblin Tracks",
					"type": "section",
					"name": "地精足迹",
					"id": "Goblin Tracks",
					"entries": [
						{
							"type": "image",
							"href": {
								"type": "external",
								"url": "https://raw.githubusercontent.com/TheGiddyLimit/homebrew-img/main/img/SoI/haRYizt.jpg"
							},
							"title": ""
						},
						"如果索恩同意加入队伍，他会从塔中取回弓和箭袋，并从围场里挑一匹马。",
						{
							"type": "image",
							"href": {
								"type": "external",
								"url": "https://raw.githubusercontent.com/TheGiddyLimit/homebrew-img/main/img/SoI/JyPx48f.jpg"
							}
						},
						{
							"type": "insetReadaloud",
							"entries": [
								"西沉的落日提醒着时间正在流逝。寒冷的北风预示着秋天将尽、寒冬将至。近乎圆满的月亮在东方的黑暗中向你们召唤。"
							]
						},
						"从永雾村延伸出去的足迹十分明显，借着月光很容易跟随。随着队伍接近无冬森林，农田渐渐让位于草甸。",
						"如果不把货车留下，它将使旅途被迫放缓，并使一切潜行尝试归于无效。",
						{
							"ENG_name": "Pond",
							"type": "entries",
							"name": "池塘",
							"id": "Pond",
							"entries": [
								"在永雾村正东五英里处，两只地精和一头座狼的尸体横陈在池塘边。它们都被斩了首，头颅不知去向。"
							]
						},
						{
							"ENG_name": "Skyglow",
							"type": "entries",
							"name": "天光",
							"id": "Skyglow",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"足迹从池塘继续向东北延伸。夜间行路时，队伍会注意到北方低云之下一抹微光。一次成功的{@dc 7} 感知（{@skill 生存}）检定可以揭示他们正沿着海姆之握的南侧绕行。以下乃是常识："
									]
								},
								{
									"ENG_name": "Helm's Hold",
									"type": "inset",
									"name": "海姆之握",
									"entries": [
										"这座设防的修道院是法术瘟疫难民的避难所。目前处于军事管制之下，只有白天因公务来访之人（携带适当文书或贿赂）才被允许进入；其他人等一律被扭送治安官处或被拒之门外。大门从黄昏到黎明封闭。"
									]
								}
							]
						},
						{
							"ENG_name": "Stream",
							"type": "entries",
							"name": "溪流",
							"id": "Stream",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"距永雾村十三英里处，足迹消失了。"
									]
								},
								{
									"type": "insetReadaloud",
									"entries": [
										"你们来到一条宽阔的浅溪前。地精的足迹进入水中，却没有在对岸重新出现。溪流以东，你们看见一片黑暗森林的边缘。"
									]
								},
								{
									"type": "entries",
									"entries": [
										"若不向上游搜寻而继续追踪袭击者，需要通过一次{@dc 18} 感知（{@skill 生存}）检定。",
										"向上游（东南）搜寻半英里的角色会自动重新发现袭击者从水中冒出的足迹。向下游（西北）搜寻的角色应掷一次{@dc 5} 感知（{@skill 生存}）检定，以认识到这条溪流流向无冬城。"
									]
								}
							]
						},
						{
							"ENG_name": "Forest",
							"type": "entries",
							"name": "森林",
							"id": "Forest",
							"entries": [
								"在上游处，足迹进入无冬森林，延续一英里直抵地下墓穴。如果角色们安静行进，以成功的敏捷（{@skill 隐匿}）检定对抗9的被动感知（{@skill 察觉}）得分，放哨的地精便不会察觉队伍，遇袭时会措手不及。"
							]
						}
					]
				},
