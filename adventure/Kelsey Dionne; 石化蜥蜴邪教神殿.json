					"name": "泥浆伪装",
					"entries": [
						"石萨满在石头、泥浆或森林地带中隐藏时，其敏捷（隐匿）检定具有优势。"
					]
				}
			],
			"action": [
				{
					"ENG_name": "Spear",
					"name": "矛",
					"entries": [
