	"classFluff": [
		{
			"name": "龙骑士",
			"ENG_name": "Dragoon (revisited)",
			"source": "dragoon revisited",
			"entries": [
				{
					"source": "dragoon revisited",
					"entries": [
						"龙骑士是一类精英骑士，专为对抗巨龙之患而受训。他们是持长柄武器作战的骑士，发展出了一套空战风格，以便更有效地刺穿宿敌的鳞甲。他们将苍穹视作大地的延伸，纵身其间，倾尽全身之力自高处扑向敌人。少数出类拔萃的龙骑士会将自己的灵魂与一枚孕育着雏龙的龙蛋绑定，彼此缔结牢不可破的羁绊。另一些龙骑士则将龙血融入自身血脉，从而获得古老的魔法与能力。"
					],
					"name": "龙骑士",
					"type": "section",
					"ENG_name": "Dragoon (revisited)"
				}
			]
		}
	],
