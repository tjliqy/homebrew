	"classFeature": [
		{
			"name": "长柄武器专家",
			"ENG_name": "Polearm Specialist",
			"source": "dragoon revisited",
			"className": "龙骑士",
			"classSource": "dragoon revisited",
			"level": 1,
			"entries": [
				"你对长柄武器进行过大量练习，长柄武器包括以下武器：标枪、矛、长矛、长柄刀、长戟、三叉戟和骑枪。持握长柄武器时，你使用它进行的伤害掷骰获得+2加值，且该武器获得触及属性（若其原本没有）。"
			]
		},
		{
			"name": "跳跃",
			"ENG_name": "Vault",
			"source": "dragoon revisited",
			"className": "龙骑士",
			"classSource": "dragoon revisited",
			"level": 1,
			"entries": [
				"在1级时，当你未穿着重甲，你可以用附赠动作进行高跳或远跳，距离上限为你的跳跃距离。跳跃不消耗移动速度。高跳时，你可以选择跳跃距离范围内的一个未被占据的空间落地。如果你撞上物体，你的跳跃中止，并开始坠落。跳跃期间，针对你的借机攻击具有劣势。",
				"你所能跳跃的最大距离随你在此职业中的等级提升而增加，如龙骑士表中所示。",
				"此外，当你有意识时，对于坠落距离低于你跳跃距离的坠落，你只受一半伤害。10级起，你不再受到坠落伤害，而非只受一半。"
			]
		},
		{
			"name": "龙类知识",
			"ENG_name": "Draconic Knowledge",
			"source": "dragoon revisited",
			"className": "龙骑士",
			"classSource": "dragoon revisited",
			"level": 2,
			"entries": [
				"从2级起，你在研究、追踪、猎杀乃至与龙类交谈方面拥有深厚的经验。",
				"你为追踪龙类而进行的感知（求生）检定、为回想关于它们的情报而进行的智力检定，以及对抗龙类或其巢穴动作的所有豁免检定，均具有优势。",
				"此外，你学会阅读、书写和讲龙语。"
			]
		},
		{
			"name": "空中突击",
			"ENG_name": "Aerial Assault",
			"source": "dragoon revisited",
			"className": "龙骑士",
			"classSource": "dragoon revisited",
			"level": 3,
			"entries": [
				"从3级起，你学会了以毁灭性的力量扑向敌人的技巧。当你持握长柄武器时，你可以发动空中突击。你可以使用此特性的次数等于1+你的体质调整值（最低为1）。",
				"当你完成一次短休或长休后，你恢复已耗用的次数。"
			]
		},
