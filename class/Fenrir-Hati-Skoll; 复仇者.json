	"classFeature": [
		{
			"ENG_name": "Armor of Faith",
			"name": "信仰护甲",
			"source": "Avenger",
			"className": "复仇者",
			"classSource": "Avenger",
			"level": 1,
			"entries": [
				"当你未穿着任何护甲时，你的护甲等级等于13+你的敏捷调整值。你仍然可以使用盾牌并获得此收益。"
			]
		},
		{
			"ENG_name": "Holy Warrior",
			"name": "神圣战士",
			"source": "Avenger",
			"className": "复仇者",
			"classSource": "Avenger",
			"level": 1,
			"entries": [
				"你挥舞重武器时的从容与优雅令敌人胆寒。你可以用你的感知调整值，而非力量或敏捷调整值，来计算所有近战武器的攻击掷骰和伤害掷骰。"
			]
		},
		{
			"ENG_name": "Oath of Enmity",
			"name": "仇敌誓言",
			"source": "Avenger",
			"className": "复仇者",
			"classSource": "Avenger",
			"level": 2,
			"entries": [
				"从第2级起，你可以在你的回合使用一个附赠动作，对你30尺内能看到的一个生物立下仇敌誓言。在接下来的1分钟里，只要该生物是距离你5尺内唯一的敌对生物，你对它发动的所有近战武器攻击掷骰便具有优势。如果你将该生物的生命值降至0，或者再次使用此能力指定一个新的目标，此能力立即结束。",
				"你可以使用此特性的次数等于你的复仇者职业等级数的一半+你的感知调整值（最少一次）。当你完成一次长休后，你恢复所有已耗用的次数。",
				"从第11级起，即使你5尺内还有其他敌对生物，你对仇敌誓言的目标仍然保持优势。",
				"此外，没有任何效果（例如劣势）能使你失去对仇敌誓言目标的优势。"
			]
		},
		{
			"ENG_name": "Ritual Casting",
			"name": "仪式施法",
			"source": "Avenger",
			"className": "复仇者",
			"classSource": "Avenger",
			"level": 2,
			"entries": [
				"当你到达第2级时，你受训所学已使你掌握了若干可以以仪式施展的法术。施法的通用规则参见《玩家手册》第10章，复仇者法术列表则见本文档。",
				{
					"ENG_name": "Rituals Known of 1st Level and Higher",
					"type": "entries",
					"name": "1环及以上的已知仪式",
					"entries": [
						"你从复仇者法术列表中选择三个1环法术并掌握它们。",
						"复仇者职业表中\"已知仪式\"一栏标示了你何时能再习得若干自选的复仇者法术。这些法术的环阶必须是你已经能够使用的环阶。例如，当你在此职业上到达第5级时，你可以习得一个新的1环或2环法术。",
						"此外，当你在此职业上提升等级时，你可以选择一个你已掌握的复仇者法术，用复仇者法术列表中的另一个法术替换它，新法术的环阶同样必须是你已经能够使用的环阶。",
						"对这些法术而言，感知是你的施法属性。"
					]
				},
				{
					"ENG_name": "Spellcasting Focus",
					"type": "entries",
					"name": "法器",
					"entries": [
						"你可以使用{@item 圣徽|phb}作为复仇者法术的施法法器。"
					]
				}
			]
		},
		{
			"ENG_name": "Sacred Studies",
			"name": "神圣研习",
			"source": "Avenger",
			"className": "复仇者",
			"classSource": "Avenger",
			"level": 2,
			"entries": [
				"在第2级，你获得宗教技能的熟练项。如果你已经熟练于该技能，则改为在以下技能中选择一项获得熟练项：洞悉、威吓、医药或察觉。你进行任何使用宗教的属性检定时，你的熟练加值翻倍。无论你从此特性中获得的是哪项技能熟练项，你都会获得这一收益。",
				"此外，你对秘传典籍的研习要求你学会一些不寻常的语言。你从以下语言中选择两种学习：深渊语、天界语、炼狱语、原初语或木族语。"
			]
		},
		{
			"ENG_name": "Channel Divinity",
			"name": "引导神力",
			"source": "Avenger",
			"className": "复仇者",
			"classSource": "Avenger",
			"level": 3,
			"entries": [
				"在第3级，你获得了直接从你的神祇那里引导神力的能力，并以此能量驱动魔法效应。你起始拥有两种此类效应：斥退亡灵和神力指引。当你使用引导神力时，你选择要创造的效应。随后你必须完成一次短休或长休，才能再次使用你的引导神力。",
				{
					"ENG_name": "Abjure Undead",
					"type": "entries",
					"name": "斥退亡灵",
					"entries": [
						"以一个动作，你亮出圣徽并诵念一段谴责亡灵的祷词。你30尺内每个能看到或听到你的亡灵必须通过一次感知豁免（DC等同于8+你的熟练加值+你的感知调整值），否则受到{@dice 3d8}点光耀伤害，并被沿直线向你拉近10尺。豁免成功的生物只受一半伤害，且不会被移动。"
					]
				},
				{
					"ENG_name": "Divine Guidance",
					"type": "entries",
					"name": "神力指引",
					"entries": [
						"当一个位于你30尺内的生物进行攻击掷骰时，你可以以一个反应举起你的圣徽并高呼祝福，使该生物的这次攻击掷骰获得优势。"
					]
				}
			]
		},
		{
			"ENG_name": "Divine Censure",
			"name": "神圣谴责",
			"source": "Avenger",
			"className": "复仇者",
			"classSource": "Avenger",
			"level": 3,
			"entries": [
				"在第3级，你选择一种谴责：追击谴责、报应谴责或团结谴责。每种谴责的详述位于职业描述的末尾。你的选择会在第3级以及第7、14和18级赋予你特性。"
			]
		},
