	"classFeature": [
		{
			"ENG_name": "Fervor",
			"name": "狂热",
			"source": "DanDWikiWarpriest",
			"page": 0,
			"className": "战争祭司",
			"classSource": "DanDWikiWarpriest",
			"level": 1,
			"entries": [
				"第1级时，战争祭司学会了一种操纵光耀能量的独特方式，将正能量或负能量汇聚于其上。战争祭司将这股能量塑成一支能量矢，掷向30尺内的一个目标。若能量矢蕴含正能量，目标受到治疗；若能量矢蕴含负能量，则对目标进行一次远程法术攻击，命中时目标受到伤害。此能力的伤害骰见战争祭司职业表。你可以使用此能力的次数等于你的感知调整值+你的等级。完成一次长休后你恢复所有充能，完成一次短休后恢复2点充能。",
				"亡灵和恶魔额外受到{@damage 1d6}点伤害。"
			]
		},
		{
			"ENG_name": "Spellcasting",
			"name": "施法",
			"source": "DanDWikiWarpriest",
			"page": 0,
			"className": "战争祭司",
			"classSource": "DanDWikiWarpriest",
			"level": 1,
			"entries": [
				"第1级时，你知晓一个{@filter 牧师法术列表中自选的戏法|spells|level=0|class=牧师}。随着等级提升，你将学会更多自选的戏法，如职业表中\"已知戏法\"一栏所示。",
				"到第2级时，你已学会汲取奥术魔法，并将其转化为神圣魔法来施展法术。",
				{
					"ENG_name": "Preparing and Casting Spells",
					"type": "entries",
					"name": "法术的准备与施展",
					"page": 0,
					"entries": [
						"战争祭司职业表展示了你拥有的、用于施展1环或更高环法术的法术位数量。施展其中一个法术时，你必须消耗一个该法术环阶或更高环阶的法术位。完成一次长休后，你恢复所有已消耗的法术位。你准备可供自己施展的战争祭司法术，从{@filter 牧师法术列表|spells|class=牧师}中选择。准备时，选择数量等于你的感知调整值+你的熟练加值的战争祭司法术。这些法术的环阶必须是你拥有相应法术位的环阶。完成一次长休后，你可以更改已准备的法术列表。准备新的法术列表需要花时间冥想回顾你先前的训练：列表上每个法术每环阶至少一分钟。"
					]
				},
				{
					"ENG_name": "Spellcasting Ability",
					"type": "entries",
					"name": "施法属性",
					"page": 0,
					"entries": [
						"感知是你法术的施法属性。你法术的力量源自你的严酷训练，以及将天生的奥术亲和转化为神圣魔法。每当法术提及你的施法属性时，你使用你的感知调整值。此外，当你设定所施展基础法术的DC以及用它进行攻击检定时，你也使用你的感知调整值。",
						{
							"ENG_name": "Spell",
							"type": "abilityDc",
							"name": "法术",
							"attributes": [
								"wis"
							]
						},
						{
							"ENG_name": "Spell",
							"type": "abilityAttackMod",
							"name": "法术",
							"attributes": [
								"wis"
							]
						}
					]
				},
				{
					"ENG_name": "Ritual Casting",
					"type": "entries",
					"name": "仪式施法",
					"page": 0,
					"entries": [
						"你可以将带有仪式标签的法术当作普通法术来施展，消耗相应的法术位。 "
					]
				},
				{
					"ENG_name": "Spellcasting Focus",
					"type": "entries",
					"name": "法器",
					"page": 0,
					"entries": [
						"你可以用你的神圣武器作为你法术的施法法器。"
					]
				}
			]
		},
		{
			"ENG_name": "Sacred Weapon",
			"name": "神圣武器",
			"source": "DanDWikiWarpriest",
			"page": 0,
			"className": "战争祭司",
			"classSource": "DanDWikiWarpriest",
			"level": 2,
			"entries": [
				"第2级时，你可以用一个附赠动作，以蕴含负能量的光耀能量灌注一把武器。被灌注的武器每次攻击命中时额外造成{@damage 1d8}点光耀伤害。",
				"伤害在5级（{@damage 2d6}）、10级（{@damage 2d8}）、15级（{@damage 3d8}）和20级（{@damage 4d8}）时提升。"
			]
		},
		{
			"ENG_name": "Warpriest Aspects",
			"name": "战争祭司之形",
			"source": "DanDWikiWarpriest",
			"page": 0,
			"className": "战争祭司",
			"classSource": "DanDWikiWarpriest",
			"level": 3,
			"entries": [
				"第3级时，你可以选择两种之形其一：战争之形或光明之形。你将在7级、13级和18级获得额外特性。"
			]
		},
		{
			"ENG_name": "Ability Score Improvement",
			"name": "属性值提升",
			"source": "DanDWikiWarpriest",
			"page": 0,
			"className": "战争祭司",
			"classSource": "DanDWikiWarpriest",
			"level": 4,
			"entries": [
				"当你达到4级、8级、12级、16级和19级时，你可以选择一项属性值提升2点，或选择两项属性各提升1点。不过你不能通过此特性让属性超过20。"
			]
		},
		{
			"ENG_name": "Extra Attack",
			"name": "额外攻击",
			"source": "DanDWikiWarpriest",
			"page": 0,
			"className": "战争祭司",
			"classSource": "DanDWikiWarpriest",
			"level": 5,
			"entries": [
				"第5级起，你在自己回合内执行{@action 攻击}动作时可以攻击两次而非一次。"
			]
		},
		{
			"ENG_name": "Sacred Pulse",
			"name": "神圣脉冲",
			"source": "DanDWikiWarpriest",
			"page": 0,
			"className": "战争祭司",
			"classSource": "DanDWikiWarpriest",
			"level": 6,
			"entries": [
				"第6级时，你学会以战争祭司为中心释放一波半径30尺的光耀能量。战争祭司必须选择该能量为正能量（半径内所有生物受到治疗）或负能量（半径内所有生物受到光耀伤害）。受此能力影响的生物可以进行一次对抗战争祭司法术豁免DC的敏捷豁免，豁免成功则只受一半伤害。此能力使用与战争祭司职业表中{@classFeature 狂热|战争祭司|DanDWikiWarpriest|1}相同的伤害骰。你每天可以使用此能力2次，完成一次长休后恢复这些使用次数。12级时，你每天可以使用此能力3次；18级时每天4次。"
			]
		},
		{
			"ENG_name": "Warpriest Aspect Feature",
			"name": "战争祭司之形特性",
			"source": "DanDWikiWarpriest",
			"page": 0,
			"className": "战争祭司",
			"classSource": "DanDWikiWarpriest",
