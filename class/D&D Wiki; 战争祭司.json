	"classFluff": [
		{
			"ENG_name": "Warpriest",
			"name": "战争祭司",
			"source": "DanDWikiWarpriest",
			"entries": [
				{
					"ENG_name": "Warpriest",
					"name": "战争祭司",
					"type": "section",
					"source": "DanDWikiWarpriest",
					"entries": [
						"一名凶悍的神圣战士，足以冲锋在前线，并能操纵融入正能量或负能量的光耀能量。",
						{
							"type": "entries",
							"entries": [
								{
									"ENG_name": "Quick Build",
									"type": "entries",
									"name": "快速建卡",
									"entries": [
										"你可以按照以下建议快速创建一个战争祭司角色。首先，感知应该是你最高的属性值，其次是力量。其次，选择{@background 平民英雄}背景。第三，选择{@spell 圣火术}戏法，以及{@skill 运动}、{@skill 游说}和{@skill 求生}技能。"
									]
								}
							]
						}
					]
				}
			]
		}
	],
