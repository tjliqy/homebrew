	"backgroundFluff": [
		{
			"ENG_name": "Cormanthor Refugee",
			"name": "科曼索难民",
			"source": "ALRageOfDemons",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								"你是数百名难民中的一员\u2014\u2014他们或被逐出远山城，或为逃离迷斯卓诺的毁灭而来，如今藏身于科曼索森林北侧林缘下的隐蔽营地中。若你在营地里长大，除了精灵树村便从未去过其他定居点。作为精灵的客人，你学会了他们的生活方式与森林的生存之道。然而你也饱受创伤\u2014\u2014残余的野魔法、苏尔坦萨坠毁于迷斯卓诺时释放的能量，以及对搜捕非人类去远山城竞技场作战的袭击的持续恐惧，都给你留下了深重的伤害，一如营地中的每个人。"
							]
						}
					]
				}
			]
		},
		{
			"ENG_name": "Gate Urchin",
			"name": "城门流浪儿",
			"source": "ALRageOfDemons",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								"所有进出贸易之城的人流物流都必须取道远山城大门，这使它成为穷苦人聚集行乞、卖艺、闲聊和扒窃的绝佳地点。你在这座钢铁巨构阴影下的街头长大，那里驻扎着红羽军和公会法师。即使你早已离开，你在他们中间仍有朋友，而那段生活也给你留下了不可磨灭的印记。"
							]
						}
					]
				}
			]
		},
		{
			"ENG_name": "Hillsfar Merchant",
			"name": "远山城商人",
			"source": "ALRageOfDemons",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								"在成为冒险者之前，你是远山城\u2014\u2014贸易之城里一位事业有成的商人。你的家族或经营货栈，或组织商队，或打理店铺，或拥有一艘船，在月海地区乃至整条剑湾沿线都有贸易人脉。他们或许向贸易之城进口矿石、未切割的宝石、未经处理的毛皮或谷物，或许出口精美布料、刻面宝石、上等毛皮，又或是龙息\u2014\u2014一种类似白兰地的烈酒。无论如何，出于某种缘由，你已基本放弃了那种生活，转而选择冒险。不过，你当年受过的训练，或许还有结下的人脉，在冒险者生涯中依然让你受益匪浅。"
							]
						}
					]
				}
			]
		},
		{
			"ENG_name": "Hillsfar Smuggler",
			"name": "远山城走私者",
			"source": "ALRageOfDemons",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								"远山城是贸易之城。然而，大贸易法案只保护\"合法\"贸易，即经由城中唯一一道城门往来的贸易，由红羽军负责监察和征税。而大人类法案则干脆将非人类逐出城市。这两部大法为走私者造就了巨大的需求和巨大的风险，他们经由秘密路线护送违禁货物和非人类进出城市。盗贼公会牢牢掌控着这一切，从获准的交易中抽成，并对私下的活计施以惩罚。",
								"或许你曾为逃避关税走私过龙息（一种类似白兰地的烈酒），或为躲避查扣运送过违禁品；又或许你是个同情非人类的人类，在协助他们偷渡远山城的秘密路线与安全屋网络中出过力。无论如何，你在走私圈子里都有熟人，只要肯出价钱，他们能帮你悄无声息地进出城。"
							]
						}
					]
				}
			]
		},
		{
			"ENG_name": "Secret Identity",
			"name": "秘密身份",
			"source": "ALRageOfDemons",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								"尽管远山城有大人类法案，你身为非人类却仍居住在这座贸易之城。你靠维持秘密身份、伪造文书和乔装改扮做到这一点。几乎无人\u2014\u2014如果有的话\u2014\u2014知道你不是人类。如果你是半身人或侏儒，就冒充小个子或孩童；如果你是半精灵、半兽人或元素裔，就掩去自己的非人类特征；其他种族则兼用伪装和遮掩性衣物来藏身。你如此生活的缘由只属于你自己：也许你是个异见者，或是某个域外势力的密探；也许你与某个不忍离去的人有所羁绊。无论如何，这种生活方式已让你付出了沉重的代价。"
							]
						}
					]
				}
			]
		},
		{
			"ENG_name": "Shade Fanatic",
			"name": "幽影狂热者",
			"source": "ALRageOfDemons",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								"你成长于耐瑟瑞尔的法师与科曼索的精灵交战的年代。你记得自己曾盘腿而坐，听人讲述辉煌的苏尔坦萨（又称幽影城邦和阴影城）的故事，一心渴望去那里求学，或许也确实研习过一段时日。几年前，苏尔坦萨自天际坠落、砸中迷斯卓诺，你的梦想也随之破碎。你知道曾有一支耐瑟瑞尔驻军屯驻远山城附近，也听闻它是因内部叛徒而覆灭。你依然忠于耐瑟瑞尔，在科曼索森林和远山城周边寻找其他幽影效忠者和狂热分子。"
							]
						}
					]
				}
			]
		},
		{
			"ENG_name": "Trade Sheriff",
			"name": "贸易警长",
			"source": "ALRageOfDemons",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								"你是确保商路时时畅通的众人之一。你不惜一切代价维护大贸易法案的施行。你或单枪匹马，或集体行动，镇压可能阻断商路通行的土匪强盗。你调查潜在的伏击和有人意图劫掠或阻截商队的传言。你既是调查员，也是执法者。你能进入远山城周边地区的城镇/村庄，找到一位愿意向你提供情报\u2014\u2014从流言到事实\u2014\u2014的线人。这有时需要送上1～9枚银币的小额贿赂。"
