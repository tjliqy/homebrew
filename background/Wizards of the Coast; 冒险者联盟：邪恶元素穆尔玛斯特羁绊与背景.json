	"backgroundFluff": [
		{
			"ENG_name": "Caravan Specialist",
			"name": "商队专家",
			"source": "ALElementalEvil",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								"你早已习惯了路上的生活。你引以为豪的是自己走遍了月海地区的每一条主要商道，包括最好的僻径与近路。行走这些道路时，你知道哪里有最好的旅店、营地和水源，也知道诸如伏击点之类潜藏危险的位置。常年在路上讨生活让你结识了许多熟人，收集那些在城镇间流传的消息与风闻对你来说易如反掌。你擅长驱使驮兽，也精通各类货车的驾驭与修理。"
							]
						}
					]
				}
			]
		},
		{
			"ENG_name": "Earthspur Miner",
			"name": "大地之刺矿工",
			"source": "ALElementalEvil",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								"你是个来自大地之刺山脉、时运不济的矿工，对艰难困苦早已司空见惯。你曾长期与同样在当地矿区干活的矮人、歌利亚和幽暗地域的居民共处。时至今日，你在地下干活已和在地上一样自如。你懂得辨识矿脉，会跟地底侏儒讨价还价置办补给，能同矮人们开怀畅饮，事后还能找到返回地面的路。只可惜，你还没发财......暂时还没有。尽管你是来穆尔玛斯特找活干的，大地之刺山脉的高峰与深矿仍在呼唤着你。"
							]
						}
					]
				}
			]
		},
		{
			"ENG_name": "Harborfolk",
			"name": "港口居民",
			"source": "ALElementalEvil",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								"你是数百名小渔民中的一员，每天清晨把穆尔玛斯特淡水港的渔获拉到城中市场。你曾在穆尔玛斯特内外的水域划过数不清的日子，对这片水域以及渔友、码头工人和港口居民的了解无人能及。尽管你已告别那种生活，偶尔还是会回去看看。"
							]
						}
					]
				}
			]
		},
		{
			"ENG_name": "Mulmaster Aristocrat",
			"name": "穆尔玛斯特贵族",
			"source": "ALElementalEvil",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								"从你位于山丘上的宅邸，你一生都在俯视（既是字面意义上，或许也是比喻意义上）穆尔玛斯特那些粗鄙的平民大众。你身披毛皮镶边的长袍，受过视觉与表演艺术的训练，这标志着你富有而且也许出身名门；你是这座\"危险之城\"贵族阶层的一员。你的直系亲属中还没有人跻身刃议会，甚至连佐尔或佐拉也不是......目前还没有。尽管如此，你仍属于穆尔玛斯特的精英；无论你个人是否觊觎更高的地位，你在贵族们聚会的舞厅中总是如鱼得水\u2014\u2014他们在那里密谋、算计、做生意、谈论艺术，而最重要的是，去看人，也被看。"
							]
						}
					]
